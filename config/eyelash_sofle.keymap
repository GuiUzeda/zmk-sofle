#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/rgbled_widget.dtsi>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;     // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&sk {
    release-after-ms = <300>;
    quick-release;
    /delete-property/ ignore-modifiers;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        // Custom tap-dances
        td_caps: td_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sk LSHIFT>, <&caps_word>;
        };

        td_accent: td_accent {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mo 2>, <&sl 5>;
        };

        td_fstate: td_fstate {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 3>, <&tog 6>;
        };

        // Custom mod-morphs for accents
        a_ag: a_ag {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_a_ag_lower>, <&macro_a_ag_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        a_til: a_til {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_a_til_lower>, <&macro_a_til_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        a_cir: a_cir {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_a_cir_lower>, <&macro_a_cir_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        a_cra: a_cra {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_a_cra_lower>, <&macro_a_cra_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        e_ag: e_ag {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_e_ag_lower>, <&macro_e_ag_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        e_til: e_til {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_e_til_lower>, <&macro_e_til_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        e_cir: e_cir {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_e_cir_lower>, <&macro_e_cir_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        o_ag: o_ag {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_o_ag_lower>, <&macro_o_ag_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        o_til: o_til {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_o_til_lower>, <&macro_o_til_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        o_cir: o_cir {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_o_cir_lower>, <&macro_o_cir_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        u_ag: u_ag {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_u_ag_lower>, <&macro_u_ag_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        i_ag: i_ag {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_i_ag_lower>, <&macro_i_ag_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        c_ced: c_ced {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_c_ced_lower>, <&macro_c_ced_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_copy_paste: win_copy_paste {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_win_copy>, <&macro_win_paste>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_copy_paste: mac_copy_paste {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_mac_copy>, <&macro_mac_paste>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {

        // Custom accent macros (lower and upper)
        macro_a_ag_lower: macro_a_ag_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp A>;
        };
        macro_a_ag_upper: macro_a_ag_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp LS(A)>;
        };

        macro_a_til_lower: macro_a_til_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp TILDE &kp A>;
        };
        macro_a_til_upper: macro_a_til_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp TILDE &kp LS(A)>;
        };

        macro_a_cir_lower: macro_a_cir_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp LS(N6) &kp A>;
        };
        macro_a_cir_upper: macro_a_cir_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp LS(N6) &kp LS(A)>;
        };

        macro_a_cra_lower: macro_a_cra_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp GRAVE &kp A>;
        };
        macro_a_cra_upper: macro_a_cra_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp GRAVE &kp LS(A)>;
        };

        macro_e_ag_lower: macro_e_ag_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp E>;
        };
        macro_e_ag_upper: macro_e_ag_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp LS(E)>;
        };

        macro_e_til_lower: macro_e_til_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp TILDE &kp E>;
        };
        macro_e_til_upper: macro_e_til_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp TILDE &kp LS(E)>;
        };

        macro_e_cir_lower: macro_e_cir_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp LS(N6) &kp E>;
        };
        macro_e_cir_upper: macro_e_cir_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp LS(N6) &kp LS(E)>;
        };

        macro_o_ag_lower: macro_o_ag_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp O>;
        };
        macro_o_ag_upper: macro_o_ag_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp LS(O)>;
        };

        macro_o_til_lower: macro_o_til_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp TILDE &kp O>;
        };
        macro_o_til_upper: macro_o_til_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp TILDE &kp LS(O)>;
        };

        macro_o_cir_lower: macro_o_cir_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp LS(N6) &kp O>;
        };
        macro_o_cir_upper: macro_o_cir_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp LS(N6) &kp LS(O)>;
        };

        macro_u_ag_lower: macro_u_ag_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp U>;
        };
        macro_u_ag_upper: macro_u_ag_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp LS(U)>;
        };

        macro_i_ag_lower: macro_i_ag_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp I>;
        };
        macro_i_ag_upper: macro_i_ag_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp LS(I)>;
        };

        macro_c_ced_lower: macro_c_ced_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp C>;
        };
        macro_c_ced_upper: macro_c_ced_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_tap &kp APOS &kp LS(C)>;
        };

        macro_win_copy: macro_win_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp C>, <&macro_release &kp LCTRL>;
        };

        macro_win_paste: macro_win_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_press &kp LCTRL>, <&macro_tap &kp V>, <&macro_release &kp LCTRL>;
        };

        macro_mac_copy: macro_mac_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp C>, <&macro_release &kp LGUI>;
        };

        macro_mac_paste: macro_mac_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &kp LSHFT &kp RSHFT>, <&macro_press &kp LGUI>, <&macro_tap &kp V>, <&macro_release &kp LGUI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layer0 {
            bindings = <
            &kp CAPS    &kp N1   &kp N2        &kp N3   &kp N4      &kp N5   &kp UP_ARROW     &kp N6     &kp N7      &kp N8        &kp N9      &kp N0             &kp PRINTSCREEN
            &kp LGUI    &kp Q    &kp W         &kp E    &kp R       &kp T    &kp DOWN_ARROW   &kp Y      &kp U       &kp I         &kp O       &kp P              &kp BSPC       
            &td_caps    &kp A    &kp S         &kp D    &kp F       &kp G    &kp LEFT_ARROW   &kp H      &kp J       &kp K         &kp L       &kp SEMI           &kp APOS       
            &kp LCTRL   &kp Z    &kp X         &kp C    &kp V       &kp B    &kp RIGHT_ARROW  &kp N      &kp M       &kp COMMA     &kp DOT     &kp FSLH           &kp ENTER      
            &kp C_MUTE  &kp DEL  &kp LEFT_ALT  &kp ESC  &td_accent  &kp TAB  &kp ENTER        &kp SPACE  &td_fstate  &kp LEFT_ALT  &kp INSERT  &kp K_APPLICATION
        >;

            sensor-bindings = <&rsr_vol>;
            display-name = "WIN_BASE";
        };
        layer_1 {
            bindings = <
            &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp GLOBE
            &kp LCTRL  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &kp LGUI   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        >;

            sensor-bindings = <&rsr_vol>;
            display-name = "MAC_BASE";
        };
        layer_2 {
            bindings = <
            &trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans  &trans    &trans     &trans     &trans     &trans  &trans
            &trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans    &trans     &trans     &trans     &trans  &trans
            &trans  &kp C_BRI_DN  &kp C_BRI_UP  &kp C_RW   &kp C_PP    &kp C_FF   &trans  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &none   &none 
            &trans &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS   &kp C_AC_SEARCH  &kp C_MUTE   &kp C_VOLUME_DOWN   &kp C_VOLUME_UP   &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none   &none 
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &mo 4      &trans     &trans     &trans
        >;

            sensor-bindings = <&rsr_vol>;
            display-name = "LAYER1";
        };
        layer_3 {
            bindings = <
           &trans &kp F1  &kp F2  &kp F3  &kp F4   &kp F5     &trans  &kp EXCL   &kp AT     &kp HASH   &kp DLLR  &kp PRCNT  &trans   
           &trans &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &trans  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR   &trans   
           &trans &kp F11 &kp F12 &kp F13 &kp F14  &kp F15    &trans  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH   &kp GRAVE
           &trans &kp F16 &kp F17 &kp F18 &kp F19  &kp F20    &trans  &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE   &kp TILDE
            &trans  &trans  &trans  &trans   &mo 4    &trans   &trans  &trans     &trans     &trans     &trans    &trans   
        >;

            sensor-bindings = <&rsr_vol>;
            display-name = "LAYER2";
        };
        layer_4 {
            bindings = <
            &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4 &trans &trans  &bt BT_CLR  &bt BT_CLR_ALL  &out OUT_USB  &out OUT_BLE  &trans  &trans
            &ind_con      &to 0            &to 1            &none            &none         &none         &trans  &none       &none           &none         &none      &none   &ind_bat 
            &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &none         &none         &trans  &none       &none           &none         &none         &none   &none 
            &rgb_ug RGB_EFF  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &none         &none         &trans  &none       &none           &none         &none         &none   &none 
            &trans           &trans           &trans           &trans           &trans        &trans        &trans  &trans      &trans          &trans        &trans        &trans
        >;

            sensor-bindings = <&rsr_vol>;
            display-name = "LAYER3";
        };
        layer_5 {
            bindings = <
            &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &e_ag   &e_til  &e_cir  &trans  &trans  &trans  &u_ag   &i_ag   &o_ag   &o_til  &trans
            &trans           &a_ag   &a_til  &a_cir  &a_cra  &trans  &trans  &trans  &trans  &trans  &o_cir  &trans  &trans
            &trans           &trans  &trans  &c_ced  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            &trans           &trans  &trans  &trans  &trans  &none   &trans  &none   &trans  &none   &trans  &trans
        >;

            sensor-bindings = <&rsr_vol>;
            display-name = "LAYER4";
        };
        layer_6 {
            bindings = <
            &trans  &trans  &trans  &trans  &trans  &trans  &trans        &none           &none    &none      &none     &none           &trans  
            &trans  &trans  &trans  &trans  &trans  &trans  &trans        &kp KP_DIVIDE    &kp KP_N7  &kp KP_N8   &kp KP_N9  &kp KP_SUBTRACT  &trans
            &trans  &trans  &trans  &trans  &trans  &trans  &trans        &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5   &kp KP_N6  &kp KP_PLUS      &trans  
            &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans           &kp KP_N1  &kp KP_N2   &kp KP_N3  &kp KP_ENTER     &trans  
            &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_ENTER  &kp KP_N0        &tog 6     &kp KP_DOT  &trans     &trans         
        >;

            sensor-bindings = <&rsr_vol>;
            display-name = "LAYER5";
        };
    };
};
